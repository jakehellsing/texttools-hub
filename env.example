# Canonical site URL — used for metadataBase, canonical links,
# Open Graph URLs, sitemap.xml, and robots.txt.
# REQUIRED in production. Copy this file to .env.local and fill in values.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Email address shown on the contact page and in the privacy policy.
NEXT_PUBLIC_CONTACT_EMAIL=contact@your-domain.com

# --- Google AdSense (leave unset until the site is approved) ---
# Publisher client ID, e.g. ca-pub-1234567890123456.
# No ad code is emitted unless this is set to a real ca-pub-* ID.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Ad unit slot IDs for each placement. Create ad units in the AdSense
# dashboard after approval, then paste the slot IDs here.
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT=
